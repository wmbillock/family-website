RewriteEngine On
RewriteBase /

# Temporary, reversible upgrade for these two existing hosts only.
# Server TLS state avoids direct/trusted-proxy loops; client headers are ignored.
RewriteCond %{HTTPS} !=on
RewriteCond %{ENV:HTTPS} !=on
RewriteCond %{HTTP_HOST} ^((?:www\.)?billock\.org)(?::80)?$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=302,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule (.*) /index.html
ErrorDocument 404 /index.html
